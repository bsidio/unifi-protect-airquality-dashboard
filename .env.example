# ─────────────── UniFi Protect ───────────────
# Your console's address (UDM / Cloud Gateway / UNVR).
UNIFI_HOST=192.168.1.1
# A LOCAL console account WITHOUT MFA. MFA breaks unattended reconnects.
# A dedicated, read-only account is the right choice here.
UNIFI_USER=protect-reader
UNIFI_PASS=change-me
# Leave 0 unless your console has a real (non self-signed) certificate.
UNIFI_VERIFY_SSL=0

# ─────────────── ClickHouse ───────────────
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=unifi_aq
CLICKHOUSE_USER=unifi_aq
CLICKHOUSE_PASSWORD=change-me

# ─────────────── Access control ───────────────
# false = anyone who can reach the app sees the dashboard (no login)
# true  = login required, using the single account below
AUTH_ENABLED=false
AUTH_USER=admin
AUTH_PASSWORD=change-me
# Session signing key: openssl rand -hex 32
APP_SECRET=change-me

# ─────────────── App ───────────────
# Site name in the header and browser tab
APP_NAME=Air Quality
COLLECTOR_ENABLED=true
COLLECTOR_FLUSH_MS=5000
# Only write a metric when its value changes (see README: dedupe + forward-fill)
COLLECTOR_DEDUPE=true

# ─────────────── Contribute to openaqi (optional) ───────────────
# openaqi.net is a free public map of crowdsourced air quality. Set a station
# key and this dashboard forwards its readings there once a minute — nothing
# else to configure, and leaving it blank keeps everything local.
#
# Get a key: https://openaqi.net/account  (register a station, ~5 km precision)
#
# What is sent: timestamps, metric names, numbers. That is all. Your
# coordinates are not in the payload — openaqi resolves location from the
# station you registered — and neither is your sensor's name.
# OPENAQI_KEY=oaq_your_station_key

# Log the exact payload and send nothing, if you would rather look first.
# OPENAQI_DRY_RUN=true

# Only for self-hosted openaqi.
# OPENAQI_SERVER=https://ingest.openaqi.net
